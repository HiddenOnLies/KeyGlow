{
  "format": "keyglow/1",
  "name": "Editing Shortcuts",
  "author": "Community example",
  "description": "Highlights Ctrl+C, Ctrl+V, Ctrl+Z and friends for photo or video editing.",
  "tags": [
    "productivity",
    "static"
  ],
  "layers": [
    {
      "effect": "solid",
      "params": {
        "color": "#101018"
      }
    },
    {
      "effect": "static",
      "params": {
        "keys": {
          "LCTRL": "#ffffff",
          "C": "#00e0ff",
          "V": "#00e0ff",
          "X": "#ff4060",
          "Z": "#ffb000",
          "Y": "#ffb000",
          "S": "#40ff80",
          "A": "#a060ff"
        }
      }
    }
  ]
}
